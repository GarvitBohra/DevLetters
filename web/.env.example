# Copy this file to .env.local and fill in your values.
# Find both in Supabase: Project Settings -> API.
# Use ONLY the public "anon" key here. Never put the service_role key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional dev-only login prefill
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Gemini (AI chat). Server-only: do NOT prefix with NEXT_PUBLIC_
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
